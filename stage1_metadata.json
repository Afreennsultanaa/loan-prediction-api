  "purpose_regex_rules": [
    {
      "pattern": "debt|consolidat",
      "category": "Debt Consolidation"
    },
    {
      "pattern": "credit card",
      "category": "Credit Card"
    },
    {
      "pattern": "home|house|property|mortgage",
      "category": "Home"
    },
    {
      "pattern": "car|auto|vehicle|motorcycle",
      "category": "Auto"
    },
    {
      "pattern": "business",
      "category": "Business"
    },
    {
      "pattern": "education|educational|school|student|college",
      "category": "Education"
    }
  ],
  "default_threshold": 0.5
