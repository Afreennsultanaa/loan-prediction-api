    "loan_amount": "Requested loan amount in USD (numeric)",
    "employment_duration": "Employment length e.g. '10+ years', '< 1 year', '3 years' or numeric integer 0-10",
    "debt_to_income_ratio": "Debt-to-income ratio (numeric or e.g. '18.5%')",
    "purpose": "Loan purpose e.g. 'debt_consolidation', 'credit_card', 'home_improvement', 'car', etc.",
    "state": "2-letter US state code e.g. 'CA', 'NY', 'TX'"
  },
  "num_cols": [
    "loan_amount",
    "employment_duration",
    "debt_to_income_ratio"
  ],
  "medians": {
    "loan_amount": 12000.0,
    "employment_duration": 1.0,
    "debt_to_income_ratio": 19.1
  },
  "modes": {
    "purpose": "debt_consolidation",
    "state": "CA"
  },
  "mappings": {
    "employment_duration_map": {
      "< 1 year": 0,
      "1 year": 1,
      "2 years": 2,
      "3 years": 3,
      "4 years": 4,
      "5 years": 5,
      "6 years": 6,
      "7 years": 7,
      "8 years": 8,
      "9 years": 9,
      "10+ years": 10
    },
    "purpose_categories": [
